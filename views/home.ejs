<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#171514"><title>Mémoires Panafricaines — Galerie vivante</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/hero-mosaic.css"></head><body><header class="nav"><a class="brand" href="/"><span class="mark">✳</span> MÉMOIRES <b>PANAFRICAINES</b></a><a href="#collection">Explorer la collection ↗</a></header><main><section class="hero hero-exhibition" aria-label="Bienvenue dans les Mémoires Panafricaines">
  <div class="hero-copy"><div class="eyebrow">ARCHIVES VIVANTES <span>◆</span> HÉRITAGES AFRICAINS</div>
  <h1>Celles et ceux<br>qui ont <em>changé</em><br>notre histoire<span class="dot">.</span></h1>
  <div class="hero-bottom"><p>Un musée numérique pour découvrir les voix, les idées et les parcours qui ont façonné l’Afrique et ses diasporas.</p><a class="circle-arrow" href="#collection" aria-label="Voir la collection">↘</a></div>
  <div class="hero-note"><span class="hero-note-line"></span> UNE HISTOIRE, MILLE VISAGES</div></div>
  <div class="hero-visual" aria-label="Portraits de personnalités africaines">
    <div class="mosaic-halo"></div>
    <div class="mosaic-columns">
    <% [0,1,2].forEach((column)=>{ const persons=heroPeople.filter((_,i)=>i%3===column); %>
      <div class="mosaic-track mosaic-track-<%= column %>"><div class="mosaic-stack">
      <% [...persons,...persons].forEach((p,i)=>{ %>
        <a class="mosaic-tile tile-tone-<%= (i+column)%6 %>" href="/personnalites/<%= encodeURIComponent(p.slug) %>" aria-label="Découvrir <%= p.name %>">
          <div class="mosaic-placeholder" aria-hidden="true"><span>✳</span><strong><%= p.name.split(' ').map(w=>w[0]).slice(0,2).join('') %></strong></div>
          <% if(p.image_url){ %><img src="<%= p.image_url %>" alt="Portrait de <%= p.name %>" loading="lazy" onerror="this.style.display='none'" /><% } %>
          <div class="mosaic-label"><strong><%= p.name %></strong><small><%= p.country %></small></div>
        </a>
      <% }) %></div></div>
    <% }) %>
    </div><div class="mosaic-fade mosaic-fade-top"></div><div class="mosaic-fade mosaic-fade-bottom"></div>
    <span class="mosaic-corner">✳ <%= total %> DESTINS À DÉCOUVRIR</span>
  </div>
</section><section id="collection" class="collection"><div class="section-top"><div><div class="eyebrow">01 / LE PANThÉON</div><h2>Des vies.<br><em>Des héritages.</em></h2></div><div class="count"><strong><%= total %></strong><span>PERSONNALITÉS</span></div></div><form class="filters" method="get"><input name="q" value="<%= q %>" placeholder="Rechercher un nom, un pays…" aria-label="Rechercher"><select name="category" aria-label="Catégorie"><option value="">Tous les domaines</option><% categories.forEach(c=>{ %><option value="<%= c.category %>" <%= category===c.category?'selected':'' %>><%= c.category %></option><% }) %></select><button>Rechercher ↗</button></form><div class="gallery"><% items.forEach((p,i)=>{ %><a class="person-card" href="/personnalites/<%= p.slug %>"><div class="art art-<%= i%6 %>"><span class="art-symbol">✳</span><span class="art-initial"><%= p.name.split(' ').map(s=>s[0]).slice(0,2).join('') %></span><% if(p.image_url){ %><img src="<%= p.image_url %>" alt="Portrait de <%= p.name %>" loading="lazy"><% } %><span class="card-index"><%= String(i+1).padStart(2,'0') %> / ARCHIVE</span></div><div class="card-info"><div><small><%= p.country %> · <%= p.category %></small><h3><%= p.name %></h3><span class="dates"><%= p.dates %></span></div><span class="card-arrow">↗</span></div></a><% }) %></div><% if(pages>1){ %><nav class="pagination" aria-label="Pagination des personnalités"><% if(page>1){ %><a href="/?q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(category) %>&page=<%= page-1 %>#collection">← Précédent</a><% } %><span>Page <strong><%= page %></strong> sur <%= pages %> · <%= total %> personnalités</span><% if(page<pages){ %><a class="next-page" href="/?q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(category) %>&page=<%= page+1 %>#collection">Découvrir les 12 suivantes →</a><% } %></nav><% } %><% if(!items.length){ %><p>Aucun résultat. Essayez une autre recherche.</p><% } %></section></main><footer><span>✳ MÉMOIRES PANAFRICAINES</span><span>La mémoire est un territoire vivant.</span><a href="/admin/login">Administration</a></footer></body></html>
