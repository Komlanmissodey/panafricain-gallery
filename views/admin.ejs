<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Collection — Administration</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/admin.css"></head><body><header class="nav"><a class="brand" href="/">✳ MÉMOIRES PANAFRICAINES</a><form action="/admin/logout" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="quiet">Déconnexion</button></form></header><main class="admin-wrap wide admin-dashboard"><div class="admin-heading"><div><div class="eyebrow">ESPACE ÉDITORIAL / COLLECTION</div><h1>Gérer les mémoires<span style="color:#bb5d42">.</span></h1><p><strong><%= total %></strong> résultat(s) · Page <%= page %> sur <%= pages %></p></div><a class="download" href="/admin/new">＋ Nouvelle personnalité</a></div><form method="get" action="/admin" class="admin-search"><label>Rechercher<input type="search" name="q" value="<%= q %>" placeholder="Nom, pays ou domaine…"></label><label>Statut<select name="status"><option value="all">Tous les statuts</option><option value="published" <%= status==='published'?'selected':'' %>>Publiés</option><option value="draft" <%= status==='draft'?'selected':'' %>>Brouillons</option></select></label><label>Trier par<select name="sort"><option value="name_asc" <%= sort==='name_asc'?'selected':'' %>>Nom : A → Z</option><option value="name_desc" <%= sort==='name_desc'?'selected':'' %>>Nom : Z → A</option><option value="recent" <%= sort==='recent'?'selected':'' %>>Ajout récent</option><option value="country" <%= sort==='country'?'selected':'' %>>Pays : A → Z</option></select></label><button type="submit">Appliquer ↗</button><a class="reset-link" href="/admin">Réinitialiser</a></form><div class="admin-export"><div><strong>Cartels QR pour exposition</strong><p>Téléchargez tous les QR des personnalités publiées, avec leur portrait en haut et le QR en bas. Les fichiers sont regroupés dans un ZIP.</p></div><a class="download" href="/admin/qr/all.zip">↓ Télécharger tous les cartels (ZIP)</a></div><div class="admin-table"><% items.forEach(p=>{ %><div class="admin-row admin-person"><div class="admin-identity"><div class="admin-avatar"><% if(p.image_url){ %><img src="<%= p.image_url %>" alt="" loading="lazy"><% }else{ %><span><%= p.name.slice(0,1) %></span><% } %></div><div><strong><%= p.name %></strong><small><%= p.country %> · <%= p.category %> · <span class="status <%= p.published?'live':'draft' %>"><%= p.published?'Publié':'Brouillon' %></span></small></div></div><div class="actions"><a href="/personnalites/<%= p.slug %>" target="_blank" rel="noopener">Voir ↗</a><a href="/admin/<%= p.id %>/edit">Modifier / portrait</a><a href="/admin/<%= p.id %>/qr">QR exposition</a><form method="post" action="/admin/<%= p.id %>/delete" onsubmit="return confirm('Supprimer définitivement cette personnalité ?')"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="danger">Supprimer</button></form></div></div><% }) %><% if(!items.length){ %><div class="empty-state">Aucune personnalité ne correspond à votre recherche. <a href="/admin">Effacer les filtres</a></div><% } %></div><% if(pages>1){ %><nav class="admin-pages" aria-label="Pages du catalogue"><% const link=n=>'/admin?'+new URLSearchParams({q,status,sort,page:n}).toString(); %><% if(page>1){ %><a href="<%= link(page-1) %>">← Précédent</a><% } %><% for(let n=Math.max(1,page-2);n<=Math.min(pages,page+2);n++){ %><a class="<%= n===page?'current':'' %>" href="<%= link(n) %>" <%- n===page?'aria-current="page"':'' %>><%= n %></a><% } %><% if(page<pages){ %><a href="<%= link(page+1) %>">Suivant →</a><% } %></nav><% } %></main></body></html>